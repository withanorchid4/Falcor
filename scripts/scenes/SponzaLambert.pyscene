"""Sponza with pure Lambert reflection, preserving textures and alpha cutouts."""
from pathlib import Path
import runpy
from falcor import PBRTDiffuseMaterial, MaterialTextureSlot

# Share geometry, lighting and camera with the original scene.
runpy.run_path(str(Path(__file__).with_name('Sponza.pyscene')),
               init_globals={'sceneBuilder': sceneBuilder})
# Imported textures are loaded asynchronously; bind them before copying slots.
sceneBuilder.waitForMaterialTextureLoading()

for original in list(sceneBuilder.materials):
    lambert = PBRTDiffuseMaterial(original.name + '-Lambert')
    lambert.baseColor = original.baseColor
    lambert.textureTransform = original.textureTransform
    lambert.doubleSided = original.doubleSided
    lambert.thinSurface = original.thinSurface
    for slot in (MaterialTextureSlot.BaseColor, MaterialTextureSlot.Normal):
        texture = original.getTexture(slot)
        if texture is not None:
            lambert.setTexture(slot, texture)
    lambert.alphaMode = original.alphaMode
    lambert.alphaThreshold = original.alphaThreshold
    # Metallic/roughness maps are intentionally omitted: f_r = baseColor / pi.
    sceneBuilder.replaceMaterial(original, lambert)
